{
  "name": "government-exam-india",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run data:validate",
    "build": "next build",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern out --ignore-pattern dist",
