{
  "name": "government-exam-india",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run data:registry && npm run data:validate:full",
    "build": "next build",
    "test:data": "tsx --test tests/data-rules.test.ts",
    "test:catalogue": "tsx --test tests/catalogue.test.ts",
    "test:search": "tsx --test tests/search.test.ts",
    "test:lifecycle": "tsx --test tests/lifecycle.test.ts",
    "test:calendar": "tsx --test tests/calendar.test.ts",
    "test:time": "tsx --test tests/time.test.ts",
    "test": "npm run test:data && npm run test:catalogue && npm run test:search && npm run test:lifecycle && npm run test:calendar && npm run test:time && npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern out --ignore-pattern dist",
    "data:registry": "tsx tools/data/build-registry.ts",
    "data:validate": "tsx tools/data/validate.ts",
    "data:validate:full": "tsx tools/data/validate.ts --require-full-coverage",
    "data:validate:fresh": "tsx tools/data/validate.ts --require-full-coverage --strict-freshness",
    "data:time-travel": "tsx tools/data/time-travel.ts",
    "data:watch": "tsx tools/data/watch-sources.ts",
    "check": "npm run lint && npm test",
    "map:build": "node tools/build-state-map.mjs",
    "icons:build": "node tools/build-icons.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "d3-geo": "^3.1.1",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.0",
    "tsx": "^4.23.5",
    "typescript": "5.9.3"
  },
  "type": "module"
}
